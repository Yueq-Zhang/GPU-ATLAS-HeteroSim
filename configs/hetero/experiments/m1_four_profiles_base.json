{
  "schema_version": "hetero-sim/v1",
  "experiment": {
    "name": "m1_four_profiles_base",
    "seed": 1,
    "generation_mode": "trace_locked"
  },
  "simulation": {
    "coupling": "operator_event",
    "execution_mode": "scheduler_validation"
  },
  "system": {
    "profile": "model1_atlas_native"
  },
  "backends": {
    "gpu": {"kind": "roofline"},
    "atlas": {"kind": "analytical"},
    "host": {"kind": "none"}
  },
  "model": {
    "name": "tiny_llama_2layer",
    "hidden_size": 128,
    "intermediate_size": 256,
    "num_layers": 2,
    "num_attention_heads": 4,
    "num_kv_heads": 2,
    "head_dim": 32,
    "vocab_size": 256,
    "dtype": "fp16",
    "bytes_per_element": 2
  },
  "workload": {
    "requests": [
      {"request_id": "R0", "arrival_time_fs": 0, "prompt_length": 16, "output_length": 3}
    ]
  },
  "scheduling": {
    "mode": "static_ragged",
    "max_num_sequences": 1,
    "max_batched_tokens": 16,
    "prefill_chunk_tokens": 16,
    "max_prefill_wait_epochs": 8,
    "epoch_duration_fs": 1000
  },
  "placement": {
    "mode": "rule_based",
    "unit": "device_subbatch_operator",
    "default_target": "gpu0",
    "rules": [
      {
        "match": {"phase": "decode", "operator_group": "attention"},
        "target": "atlas0.compute"
      }
    ],
    "data": {
      "kv_cache": {"home": "primary_3ddram", "layout": "paged", "page_tokens": 16}
    }
  },
  "address": {
    "allocator": "first_fit",
    "page_tokens": 16,
    "kv_capacity_bytes": 1073741824
  },
  "metrics": {
    "request": ["ttft", "tpot", "e2e_user"]
  }
}
