{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hetero-sim/v1",
  "title": "GPU-ATLAS Heterogeneous Simulation Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment", "simulation", "system", "backends",
    "model", "workload", "scheduling", "placement", "address", "metrics"
  ],
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["ref"],
      "properties": {"ref": {"type": "string", "minLength": 1}}
    },
    "backend": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "ref": {"type": "string", "minLength": 1},
        "requested_timing_mode": {"type": "string"},
        "effective_compute_flops_per_s": {"type": "integer", "minimum": 1},
        "effective_memory_bandwidth_Bps": {"type": "integer", "minimum": 1},
        "parameter_source": {"type": "string", "minLength": 1},
        "config_ref": {"type": "string", "minLength": 1},
        "fallback_kind": {"enum": ["none", "analytical", "runtime_cycle"]},
        "runtime_task_model_ref": {"type": "string", "minLength": 1},
        "runtime_task_operators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "external_memory_bridge": {"type": "string"},
        "exports_memory_requests": {"type": "boolean"},
        "supports_stall_resume": {"type": "boolean"},
        "require_request_cycle_ready": {"type": "boolean"},
        "cycle_artifact_ref": {"type": "string", "minLength": 1},
        "operator_artifact_catalog_ref": {"type": "string", "minLength": 1},
        "artifact_use_mode": {"const": "memory_traffic_lowering_only"},
        "full_traffic_operators": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "device_clock_hz": {"type": "integer", "minimum": 1},
        "resource_bindings": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "trace_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "trace_manifest", "compatibility"],
            "properties": {
              "selector": {"type": "object", "minProperties": 1},
              "trace_manifest": {"type": "string", "minLength": 1},
              "operator_artifact": {"type": "string", "minLength": 1},
              "compatibility": {"enum": ["exact_operator", "surrogate_plumbing_probe"]},
              "contract_overrides": {"type": "object"},
              "value_bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tensor_id", "source", "index", "value_offset_bytes"],
                  "properties": {
                    "tensor_id": {"type": "string", "minLength": 1},
                    "source": {"enum": ["input", "output"]},
                    "index": {"type": "integer", "minimum": 0},
                    "value_offset_bytes": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          }
        },
        "artifact_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selector", "chip_config", "operator_list", "placement_map",
              "compatibility"
            ],
            "properties": {
              "selector": {"type": "object", "minProperties": 1},
              "chip_config": {"type": "string", "minLength": 1},
              "operator_list": {"type": "string", "minLength": 1},
              "placement_map": {"type": "string", "minLength": 1},
              "compatibility": {
                "enum": ["exact_operator", "surrogate_plumbing_probe"]
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "hidden_size", "intermediate_size", "num_layers",
        "num_attention_heads", "num_kv_heads", "head_dim", "vocab_size",
        "dtype", "bytes_per_element"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "intermediate_size": {"type": "integer", "minimum": 1},
        "num_layers": {"type": "integer", "minimum": 1},
        "num_attention_heads": {"type": "integer", "minimum": 1},
        "num_kv_heads": {"type": "integer", "minimum": 1},
        "head_dim": {"type": "integer", "minimum": 1},
        "vocab_size": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string", "minLength": 1},
        "bytes_per_element": {"type": "integer", "minimum": 1},
        "architecture": {"type": "string", "minLength": 1},
        "mlp_type": {"enum": ["swiglu", "dense_gelu"]},
        "position_encoding": {"enum": ["rope", "learned_absolute"]},
        "tied_embeddings": {"type": "boolean"}
        ,"input_embedding_mode": {"enum": ["preembedded", "token_ids"]}
        ,"materialize_parameters": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "prompt_length", "output_length"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "arrival_time_fs": {"type": "integer", "minimum": 0},
        "prompt_length": {"type": "integer", "minimum": 1},
        "output_length": {"type": "integer", "minimum": 1},
        "priority": {"type": "integer"},
        "execution_scope": {"enum": ["full_request", "decode_step"]},
        "initial_kv_length": {"type": "integer", "minimum": 0}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false, "required": ["requests"],
      "properties": {"requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}}}
    },
    "scheduler": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "max_num_sequences", "max_batched_tokens", "prefill_chunk_tokens", "epoch_duration_fs"],
      "properties": {
        "mode": {"enum": ["static_ragged", "continuous", "continuous_batching"]},
        "epoch_mode": {"enum": ["token_step_barrier"]},
        "admission": {"enum": ["fcfs", "kv_capacity_aware"]},
        "decode_priority": {"type": "boolean"},
        "prefill_aging": {"type": "boolean"},
        "max_num_sequences": {"type": "integer", "minimum": 1},
        "max_batched_tokens": {"type": "integer", "minimum": 1},
        "prefill_chunk_tokens": {"type": "integer", "minimum": 1},
        "max_prefill_wait_epochs": {"type": "integer", "minimum": 0},
        "kv_reservation_mode": {"enum": ["full_request", "max_request"]},
        "epoch_duration_fs": {"type": "integer", "minimum": 1}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "default_target"],
      "properties": {
        "mode": {"enum": ["manual", "rule_based", "auto_dse"]},
        "unit": {"type": "string"},
        "default_target": {"type": "string", "minLength": 1},
        "rules": {"type": "array", "items": {"type": "object"}},
        "data": {"type": "object"}
      }
    },
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["allocator", "page_tokens", "kv_capacity_bytes"],
      "properties": {
        "allocator": {"enum": ["first_fit"]},
        "page_tokens": {"type": "integer", "minimum": 1},
        "kv_capacity_bytes": {"type": "integer", "minimum": 1},
        "allocation_alignment_bytes": {"type": "integer", "minimum": 1},
        "global_pa_capacity_bytes": {"type": "integer", "minimum": 1},
        "memory_spaces": {"type": "array"},
        "address_mapping": {"type": "object"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["request"],
      "properties": {"request": {"type": "array", "items": {"type": "string"}}}
    }
  },
  "properties": {
    "schema_version": {"const": "hetero-sim/v1"},
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "seed", "generation_mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "generation_mode": {"enum": ["trace_locked", "fixed_tokens", "functional_generation", "replayed_eos"]}
      }
    },
    "simulation": {
      "type": "object", "additionalProperties": false, "required": ["coupling"],
      "properties": {
        "coupling": {"enum": ["analytical", "operator_event", "request_cycle"]},
        "execution_mode": {"enum": ["scheduler_validation", "analytical_preview", "operator_event", "full_runtime", "prefill_cycle"]},
        "validation_policy": {"enum": ["required", "deferred"]}
      }
    },
    "system": {
      "type": "object", "additionalProperties": false, "required": ["profile"],
      "properties": {
        "profile": {"enum": ["model1_atlas_native", "model2_host_memory_pcie", "model3_gpu_native_3ddram", "model4_cxl_memory_tier"]},
        "topology_ref": {"type": "string"},
        "access_policy": {"enum": ["remote", "copy", "migrate"]},
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["wire_bandwidth_Bps", "latency_fs", "header_bytes", "resource_id", "parameter_source"],
            "properties": {
              "wire_bandwidth_Bps": {"type": "integer", "minimum": 1},
              "latency_fs": {"type": "integer", "minimum": 0},
              "header_bytes": {"type": "integer", "minimum": 0},
              "resource_id": {"type": "string", "minLength": 1},
              "parameter_source": {"type": "string", "minLength": 1},
              "queue_depth_transactions": {"type": "integer", "minimum": 1},
              "credits": {"type": "integer", "minimum": 1},
              "full_duplex": {"type": "boolean"},
              "max_payload_bytes": {"type": "integer", "minimum": 1},
              "protocol": {"type": "string", "minLength": 1}
            }
          }
        },
        "memory_services": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "timing_owner", "parameter_source"],
            "properties": {
              "kind": {"enum": ["shared_3d_reference", "ramulator2"]},
              "access_mode": {"enum": ["gpu_only", "shared_gpu_atlas"]},
              "timing_owner": {"type": "string", "minLength": 1},
              "channel_count": {"type": "integer", "minimum": 1},
              "banks_per_channel": {"type": "integer", "minimum": 1},
              "transaction_bytes": {"type": "integer", "minimum": 1},
              "queue_depth_per_initiator": {"type": "integer", "minimum": 1},
              "fixed_latency_fs": {"type": "integer", "minimum": 1},
              "channel_injection_interval_fs": {"type": "integer", "minimum": 0},
              "bank_busy_time_fs": {"type": "integer", "minimum": 0},
              "initiator_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "config_ref": {"type": "string"},
              "bridge_library": {"type": "string", "minLength": 1},
              "gpu_clock_hz": {"type": "integer", "minimum": 1},
              "link_clock_hz": {"type": "integer", "minimum": 1},
              "gateway_clock_hz": {"type": "integer", "minimum": 1},
              "dram_clock_hz": {"type": "integer", "minimum": 1},
              "gateway_ingress_queue_depth": {"type": "integer", "minimum": 1},
              "gateway_parent_table_entries": {"type": "integer", "minimum": 1},
              "gateway_issue_width": {"type": "integer", "minimum": 1},
              "write_ack_policy": {"enum": ["durable", "posted"]},
              "request_bandwidth_Bps": {"type": "integer", "minimum": 1},
              "response_bandwidth_Bps": {"type": "integer", "minimum": 1},
              "request_header_bytes": {"type": "integer", "minimum": 0},
              "response_header_bytes": {"type": "integer", "minimum": 0},
              "flit_bytes": {"type": "integer", "minimum": 1},
              "propagation_latency_fs": {"type": "integer", "minimum": 0},
              "external_queue_depth": {"type": "integer", "minimum": 1},
              "external_credits": {"type": "integer", "minimum": 1},
              "duplex_mode": {"enum": ["full_duplex", "half_duplex"]},
              "max_samples_per_value": {"type": "integer", "minimum": 1},
              "sampling_policy": {"const": "evenly_spaced_bounded"},
              "parameter_source": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"kind": {"const": "shared_3d_reference"}}},
                "then": {
                  "required": [
                    "channel_count", "banks_per_channel", "transaction_bytes",
                    "queue_depth_per_initiator", "fixed_latency_fs", "initiator_order"
                  ]
                }
              },
              {
                "if": {"properties": {"kind": {"const": "ramulator2"}}},
                "then": {"required": ["config_ref"]}
              }
            ]
          }
        },
        "memory_ports": {"type": "object"},
        "cxl": {"type": "object"}
      }
    },
    "backends": {
      "type": "object", "additionalProperties": false, "required": ["gpu", "atlas", "host"],
      "properties": {
        "gpu": {"$ref": "#/$defs/backend"},
        "atlas": {"$ref": "#/$defs/backend"},
        "host": {"$ref": "#/$defs/backend"}
      }
    },
    "model": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/model"}]},
    "workload": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/workload"}]},
    "scheduling": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/scheduler"}]},
    "placement": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/placement"}]},
    "address": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/address"}]},
    "metrics": {"oneOf": [{"$ref": "#/$defs/ref"}, {"$ref": "#/$defs/metrics"}]}
  }
}
