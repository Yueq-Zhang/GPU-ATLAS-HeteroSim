{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hetero-performance-calibration/v1",
  "type": "object",
  "required": [
    "schema_version",
    "calibration_id",
    "target_system",
    "scope",
    "qualification_policy",
    "configuration_sources",
    "components"
  ],
  "properties": {
    "schema_version": {"const": "hetero-performance-calibration/v1"},
    "calibration_id": {"type": "string", "minLength": 1},
    "target_system": {"type": "object"},
    "scope": {"type": "object"},
    "qualification_policy": {
      "type": "object",
      "required": [
        "required_shape_key",
        "required_components",
        "required_metrics",
        "allowed_validation_evidence",
        "minimum_reference_points_per_component"
      ],
      "properties": {
        "required_shape_key": {"type": "string", "minLength": 1},
        "required_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allowed_validation_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["hardware_measurement", "trusted_reference_simulator"]
          }
        },
        "minimum_reference_points_per_component": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "configuration_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "hash_mode": {"enum": ["raw_bytes", "text_lf_utf8"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/component"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "required",
        "status",
        "timing_owner",
        "parameter_bindings",
        "sources",
        "reference_points",
        "applicable_shape_keys",
        "notes"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "status": {
          "enum": [
            "missing",
            "specified_only",
            "measured_unvalidated",
            "validated",
            "not_applicable"
          ]
        },
        "timing_owner": {"type": "string", "minLength": 1},
        "parameter_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "configured_value",
              "unit",
              "configuration_source_id"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "configured_value": {},
              "unit": {"type": "string", "minLength": 1},
              "configuration_source_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "evidence_class", "locator", "description"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "evidence_class": {
                "enum": [
                  "hardware_measurement",
                  "trusted_reference_simulator",
                  "official_specification",
                  "implementation_configuration"
                ]
              },
              "locator": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifact_hash_mode": {"enum": ["raw_bytes", "text_lf_utf8"]},
              "measurement_scope": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "reference_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reference_id",
              "source_id",
              "metric",
              "measured_value",
              "simulated_value",
              "unit",
              "repetitions",
              "statistic",
              "max_relative_error",
              "max_absolute_error"
            ],
            "properties": {
              "reference_id": {"type": "string", "minLength": 1},
              "source_id": {"type": "string", "minLength": 1},
              "metric": {"type": "string", "minLength": 1},
              "measured_value": {"type": "number", "minimum": 0},
              "simulated_value": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "minLength": 1},
              "repetitions": {"type": "integer", "minimum": 1},
              "statistic": {"type": "string", "minLength": 1},
              "max_relative_error": {"type": "number", "minimum": 0},
              "max_absolute_error": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "applicable_shape_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
