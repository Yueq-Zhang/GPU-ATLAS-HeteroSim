diff --git a/simulator/src/dram/external_dram_service.h b/simulator/src/dram/external_dram_service.h
new file mode 100644
index 0000000..532129a
--- /dev/null
+++ b/simulator/src/dram/external_dram_service.h
@@ -0,0 +1,48 @@
+#ifndef _ATLASIM_EXTERNAL_DRAM_SERVICE_H
+#define _ATLASIM_EXTERNAL_DRAM_SERVICE_H
+
+#include <cstdint>
+#include <memory>
+
+#include "core/component.h"
+
+namespace atlasim {
+
+struct ExternalDramRequestKey {
+    int core_id = -1;
+    int task_id = -1;
+    int iteration = -1;
+
+    bool operator==(const ExternalDramRequestKey& other) const {
+        return core_id == other.core_id &&
+               task_id == other.task_id &&
+               iteration == other.iteration;
+    }
+};
+
+struct ExternalDramTraffic {
+    uint64_t read_bytes = 0;
+    uint64_t write_bytes = 0;
+
+    uint64_t total_bytes() const { return read_bytes + write_bytes; }
+};
+
+class IExternalDramService {
+public:
+    virtual ~IExternalDramService() = default;
+
+    virtual ExternalDramTraffic estimate_traffic(
+        int core_id, const ComponentInput& input) const = 0;
+    virtual double max_bandwidth_gbps_per_core() const = 0;
+    virtual bool submit_iteration(
+        const ExternalDramRequestKey& key, const ComponentInput& input) = 0;
+    virtual bool iteration_complete(
+        const ExternalDramRequestKey& key) const = 0;
+    virtual void retire_iteration(const ExternalDramRequestKey& key) = 0;
+};
+
+using ExternalDramService = std::shared_ptr<IExternalDramService>;
+
+}  // namespace atlasim
+
+#endif  // _ATLASIM_EXTERNAL_DRAM_SERVICE_H
